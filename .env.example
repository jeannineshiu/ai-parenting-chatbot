# OpenAI API key (required) — used for embeddings and chat completions
OPENAI_API_KEY=sk-...

# Base URL of the ElternLeben mock service API (webinars & consultations).
# Default resolves to the host machine from inside Docker on macOS/Windows.
MOCK_API_URL=http://host.docker.internal:8001

# Folder containing the ElternLeben.de Markdown articles.
# Set automatically to /data in docker-compose; defaults to ../data when run locally.
# DATA_DIR=/data
